{
  "name": "ai-harness",
  "version": "0.1.0",
  "description": "Harness multi-agente universal: esteira autonoma (plan, code, qa, rework, sync) com contexto minimo, loop ReAct + MCPs e dashboard local.",
  "type": "module",
  "bin": {
    "ai": "dist/index.js"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:cli": "node scripts/check-cli.mjs",
    "check": "npm run build && npm run typecheck && npm run check:cli && npm run check:spec",
    "clean": "rm -rf dist",
    "check:spec": "node scripts/check-spec.mjs"
  },
  "files": [
    "dist",
    "templates"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "openai": "^4.104.0",
    "yaml": "^2.9.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
