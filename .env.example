# ── Harness provider selection ──────────────────────────────────────────────
# Which WIRE FORMAT the harness speaks. One of: auto | kiro | openai | claude
# `auto` (default) infers it from whichever endpoint you configured below.
# Precedence: CLI flag --provider > .harness/context.json:provider > this value
HARNESS_PROVIDER=auto

# Hard cap on ReAct loop iterations per task (5-10 recommended)
HARNESS_MAX_ITERATIONS=8

# Total attempts per model call before giving up (1 disables retries)
# HARNESS_PROVIDER_RETRIES=3

# ── Generic endpoint (canonical — works for any provider) ────────────────────
# Change these three lines to switch providers. No code changes needed.
#
#   Groq        https://api.groq.com/openai/v1     gsk_...      openai/gpt-oss-120b
#   DeepSeek    https://api.deepseek.com           sk-...       deepseek-chat
#   OpenRouter  https://openrouter.ai/api/v1       sk-or-...    anthropic/claude-sonnet-4
#   Ollama      http://127.0.0.1:11434             (no key)     qwen3:1.7b
#   OpenAI      https://api.openai.com/v1          sk-...       gpt-4o-mini
#
# `/v1` is appended automatically when missing; a pasted
# `/v1/chat/completions` suffix is stripped.
# HARNESS_BASE_URL=https://api.groq.com/openai/v1
# HARNESS_API_KEY=<your-key>
# HARNESS_MODEL=openai/gpt-oss-120b

# Comma-separated reserve models tried when the primary one fails (404/quota).
# Keeps a task alive instead of aborting on the first provider hiccup.
# HARNESS_MODEL_FALLBACKS=openai/gpt-oss-20b

# ── Kiro (AWS / SSO corporativo) — needs NO credentials ──────────────────────
# Primary strategy: reuse the local Kiro CLI session (SSO inherited, no keys).
# This is why the generic HARNESS_API_KEY above is optional: providers that
# authenticate out-of-band simply ignore it.
#
# Optional override for the CLI binary; otherwise auto-detected:
#   kiro-cli-chat -> kiro-cli -> kiro
# KIRO_CLI_BIN=kiro-cli-chat

# Fallback ONLY used when the local CLI binary is not found on PATH.
# KIRO_GATEWAY_URL=https://your-kiro-gateway.internal/chat
# KIRO_SESSION_TOKEN=<your-session-token>

# Optional override for the Kiro V5 template folder.
# Defaults to <install>/templates/kiro-v5
# KIRO_TEMPLATES_PATH=<install>/templates/kiro-v5

# ── Legacy aliases (still honored, LOWER precedence than HARNESS_*) ──────────
# OpenAI-compatible endpoints (DeepSeek/Groq/OpenRouter/Ollama):
# OPENAI_API_KEY=<key>
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-chat
#
# Claude / Anthropic (Messages API — different wire format):
# ANTHROPIC_API_KEY=<key>
# CLAUDE_MODEL=claude-3-5-sonnet-latest
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── Design / Figma MCP ───────────────────────────────────────────────────────
# Personal Figma token; injected as Bearer into the Figma MCP HTTP transport.
# Used ONLY by design personas when a Figma URL is provided. Without it, pass a
# screenshot/export path to the design command (fallback mode).
# FIGMA_ACCESS_TOKEN=figd_...
# FIGMA_MCP_URL=https://mcp.figma.com/mcp

# ── Dashboard ────────────────────────────────────────────────────────────────
# DASHBOARD_PORT=3000
